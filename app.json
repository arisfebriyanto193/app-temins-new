{
  "expo": {
    "name": "temins-app",
    "slug": "temins-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-app.png",
    "scheme": "teminsapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "owner": "arisfebriyanto76",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "package": "com.arisfebriyanto76.teminsapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-app.png",
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "NOTIFICATIONS"
      ]
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-app.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo-app.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-app.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe56ee36-40b7-4003-9fed-8550b23af242"
      }
    }
  }
}